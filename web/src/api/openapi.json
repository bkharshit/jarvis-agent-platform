  "components": {
    "schemas": {
      "AgentDefinition": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "title": "Name"
          },
          "description": {
            "type": "string",
            "title": "Description",
            "default": ""
          },
          "model": {
            "$ref": "#/components/schemas/ModelRef"
          },
          "system_prompt": {
            "type": "string",
            "title": "System Prompt",
            "default": ""
          },
          "user_prompt_template": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "User Prompt Template"
          },
          "tools": {
            "items": {
              "$ref": "#/components/schemas/ToolBinding"
            },
            "type": "array",
            "title": "Tools"
          },
          "strategy": {
            "$ref": "#/components/schemas/StrategyConfig"
          },
          "memory": {
            "$ref": "#/components/schemas/MemoryConfig"
          },
          "max_iterations": {
            "type": "integer",
            "maximum": 32.0,
            "minimum": 1.0,
            "title": "Max Iterations",
            "default": 8
          },
          "temperature": {
            "type": "number",
            "maximum": 2.0,
            "minimum": 0.0,
            "title": "Temperature",
            "default": 0.7
          },
          "output_schema": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Output Schema"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "model",
          "strategy"
        ],
        "title": "AgentDefinition"
      },
      "AgentDetail": {
        "properties": {
          "definition": {
            "$ref": "#/components/schemas/AgentDefinition"
          },
          "versions": {
            "items": {
              "$ref": "#/components/schemas/VersionSummary"
            },
            "type": "array",
            "title": "Versions"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "definition",
          "versions"
        ],
        "title": "AgentDetail"
      },
      "AgentList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/AgentDefinition"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "items"
        ],
        "title": "AgentList"
      },
      "AgentUpsertRequest": {
        "properties": {
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "model": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ModelRef"
              },
              {
                "type": "null"
              }
            ]
          },
          "system_prompt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "System Prompt"
          },
          "user_prompt_template": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "User Prompt Template"
          },
          "tools": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ToolBinding"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tools"
          },
          "strategy": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/StrategyConfig"
              },
              {
                "type": "null"
              }
            ]
          },
          "memory": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MemoryConfig"
              },
              {
                "type": "null"
              }
            ]
          },
          "max_iterations": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 32.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Iterations"
          },
          "temperature": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 2.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Temperature"
          },
          "output_schema": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Output Schema"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "AgentUpsertRequest",
        "description": "Partial create/update payload \u2014 everything except name/model/strategy\nis optional and falls back to the AgentDefinition defaults."
      },
      "AgentVersion": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "agent_id": {
            "type": "string",
            "title": "Agent Id"
          },
          "version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Version"
          },
          "snapshot": {
            "$ref": "#/components/schemas/AgentDefinition"
          },
          "label": {
            "type": "string",
            "title": "Label",
            "default": ""
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "agent_id",
          "version",
          "snapshot"
        ],
        "title": "AgentVersion",
        "description": "Immutable, append-only snapshot of an AgentDefinition.\n\n`snapshot` is the replay source of truth for every execution that\nreferences this version (ADR 0002: snapshot-vs-reference)."
      },
      "CancelResult": {
        "properties": {
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "cancelled": {
            "type": "boolean",
            "title": "Cancelled"
          },
          "status": {
