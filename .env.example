# JARVIS configuration. Copy to .env and adjust.
JARVIS_DATABASE_URL=postgresql+asyncpg://jarvis:jarvis@localhost:5432/jarvis
JARVIS_MODEL_PROVIDER=openai_compatible
JARVIS_MODEL_BASE_URL=https://api.openai.com/v1
JARVIS_MODEL_API_KEY_ENV=OPENAI_API_KEY
JARVIS_MODEL_NAME=gpt-4o-mini
# Orchestrator limits (platform-wide overrides; per-agent caps live in the
# agent definition):
# JARVIS_RUN_MAX_ITERATIONS=8
# JARVIS_RUN_MAX_TOTAL_TOKENS=200000
# JARVIS_RUN_TIMEOUT_SECONDS=120
# HTTP server:
# JARVIS_HOST=127.0.0.1
# JARVIS_PORT=8000
# Local Ollama instead:
# JARVIS_MODEL_BASE_URL=http://localhost:11434/v1